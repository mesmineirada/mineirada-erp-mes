# Project URL e publishable/anon key do Supabase.
# A chave publishable/anon pode estar no bundle do navegador, desde que RLS esteja habilitado.
# Nunca use SUPABASE_SERVICE_ROLE_KEY em VITE_* nem publique a service_role/secret key.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publishable-ou-anon
